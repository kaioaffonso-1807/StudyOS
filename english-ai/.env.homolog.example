# StudyOS homologation environment
# Copy values into the app-specific .env files as needed.
NODE_ENV=development
PORT=4000
AUTH_REQUIRED=false
BILLING_ENABLED=false
OPENAI_API_KEY=
DATABASE_URL=

# Mobile: use your computer LAN IP when testing on a physical Android device.
# Example: http://192.168.1.10:4000
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_IP:4000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
