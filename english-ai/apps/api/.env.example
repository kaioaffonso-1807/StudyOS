NODE_ENV=development
PORT=4000

# Authentication (Supabase)
# Set AUTH_REQUIRED=true in production. Keep false only for local/demo development.
AUTH_REQUIRED=false
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Reverse proxy: enable only when the deployment platform terminates the proxy in front of this API.
TRUST_PROXY=false
TRUST_PROXY_HOPS=1

# Cloud PostgreSQL (Supabase, Neon, Railway, Render, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
# Optional: PEM CA certificate when your provider requires a custom CA.
DATABASE_SSL_CA=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# Stripe billing (server-side only)
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
BILLING_SUCCESS_URL=https://YOUR_APP.example/billing/success
BILLING_CANCEL_URL=https://YOUR_APP.example/billing/cancel
BILLING_PORTAL_RETURN_URL=https://YOUR_APP.example/settings/billing

# Daily usage limits. Defaults are intentionally conservative and can be changed without code changes.
USAGE_FREE_AI_TURNS_DAILY=10
USAGE_FREE_VOICE_TURNS_DAILY=3
USAGE_FREE_REALTIME_CALLS_DAILY=5
USAGE_PRO_AI_TURNS_DAILY=100
USAGE_PRO_VOICE_TURNS_DAILY=30
USAGE_PRO_REALTIME_CALLS_DAILY=30
