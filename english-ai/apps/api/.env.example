PORT=4000

# Authentication (Supabase)
# Set AUTH_REQUIRED=true in production. Keep false only for local/demo development.
AUTH_REQUIRED=false
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Production network/security
NODE_ENV=development
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AI_RATE_LIMIT_MAX_REQUESTS=30

# Cloud PostgreSQL (Supabase, Neon, Railway, Render, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://YOUR_APP/billing/success
STRIPE_CANCEL_URL=https://YOUR_APP/billing/cancel
STRIPE_PORTAL_RETURN_URL=https://YOUR_APP/billing

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
